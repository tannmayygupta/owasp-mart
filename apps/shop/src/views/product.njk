{% extends "layout.njk" %}
{% block title %}{{ product.title }}{% endblock %}
{% block body %}
<p class="crumbs"><a href="/shop">Shop</a> / {{ product.title }}</p>
<div class="detail">
  <div class="art a{{ product.id % 6 }}" aria-hidden="true">{{ product.title | first | upper }}</div>
  <div>
    <h1>{{ product.title }}</h1>
    <p class="muted">{{ product.description }}</p>
    <p class="price">{{ product.price_cents | cents }}</p>
    <form class="buy" method="post" action="/cart/add" data-widget="add-to-cart">
      <input type="hidden" name="csrf" value="{{ csrf }}">
      <input type="hidden" name="product_id" value="{{ product.id }}">
      <input type="number" name="qty" value="1" min="1" aria-label="Quantity">
      <button>Add to cart</button>
    </form>
    {% if not user %}<p class="muted">You will be asked to <a href="/login">log in</a> before the item goes into your cart.</p>{% endif %}
  </div>
</div>
<section class="reviews">
  <h2>Reviews</h2>
  {% for r in reviews %}<div class="card review"><span class="stars" aria-hidden="true">{% for i in range(r.rating) %}★{% endfor %}</span> <strong>{{ r.rating }}/5</strong><p>{{ r.body }}</p></div>
  {% else %}<p class="muted">No reviews yet.</p>{% endfor %}
</section>
{% endblock %}
