<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="csrf-token" content="{{ csrf }}">
  <title>{% block title %}{{ brand.name }}{% endblock %} · {{ brand.name }}</title>
  <style>{% include "partials/theme.css" %}</style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-in">
      <a class="brand" href="/shop" aria-label="{{ brand.name }} home">
        <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true"><rect width="34" height="34" rx="9" fill="#e8553d"/><path d="M8 11h18l-2 11a3 3 0 0 1-3 2.5H13a3 3 0 0 1-3-2.5L8 11Z" fill="#fff" opacity=".95"/><path d="M12.5 11V9.5a4.5 4.5 0 0 1 9 0V11" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>
        <span><strong>{{ brand.name }}</strong><small>{{ brand.tagline }}</small></span>
      </a>
      <nav class="nav" aria-label="Main">
        <a href="/shop"{% if path == '/shop' or path == '/' %} class="on"{% endif %}>Shop</a>
        {% if user %}
          {% if user.role == "customer" %}
            <a href="/orders"{% if path == '/orders' %} class="on"{% endif %}>Orders</a>
            <a href="/cart"{% if path == '/cart' %} class="on"{% endif %}>Cart</a>
            <a href="/seller/register">Sell with us</a>
            <a href="/wallet"{% if path == '/wallet' %} class="on"{% endif %}>Gift cards</a>
            <a href="/tickets"{% if path == '/tickets' %} class="on"{% endif %}>Support</a>
          {% endif %}
          {% if user.role == "seller_owner" or user.role == "seller_staff" %}
            <a href="/seller"{% if path == '/seller' %} class="on"{% endif %}>Seller</a>
            <a href="/seller/orders"{% if path == '/seller/orders' %} class="on"{% endif %}>Orders</a>
          {% endif %}
          {% if user.role == "seller_owner" %}
            <a href="/seller/payouts"{% if path == '/seller/payouts' %} class="on"{% endif %}>Payouts</a>
          {% endif %}
          {% if user.role == "support_agent" or user.role == "admin" %}
            <a href="/staff/tickets"{% if path == '/staff/tickets' %} class="on"{% endif %}>Tickets</a>
            <a href="/staff/disputes"{% if path == '/staff/disputes' %} class="on"{% endif %}>Disputes</a>
            <a href="/staff/refunds"{% if path == '/staff/refunds' %} class="on"{% endif %}>Refunds</a>
            <a href="/support/cases/notes"{% if path == '/support/cases/notes' %} class="on"{% endif %}>Case notes</a>
          {% endif %}
          {% if user.role == "finance" or user.role == "admin" %}
            <a href="/staff/payouts"{% if path == '/staff/payouts' %} class="on"{% endif %}>Payouts</a>
            <a href="/finance/settings/settlement"{% if path == '/finance/settings/settlement' %} class="on"{% endif %}>Settlement</a>
          {% endif %}
          {% if user.role == "admin" %}
            <a href="/staff/users"{% if path == '/staff/users' %} class="on"{% endif %}>Users</a>
            <a href="/staff/audit"{% if path == '/staff/audit' %} class="on"{% endif %}>Audit</a>
          {% endif %}
        {% endif %}
      </nav>
      <span class="spacer"></span>
      {% if user %}
      <div class="who">
        <span class="avatar" aria-hidden="true">{{ user.email | first | upper }}</span>
        {% if user.role != "customer" %}<span class="role">{{ user.role | replace("_", " ") }}</span>{% endif %}
        <form class="inline" method="post" action="/logout"><input type="hidden" name="csrf" value="{{ csrf }}"><button>Log out ({{ user.email }})</button></form>
      </div>
      {% else %}<a class="signin" href="/login">Log in</a> <a class="signin" href="/register">Sign up</a>{% endif %}
    </div>
  </header>
  <main>
    {% if flash %}<div class="flash" role="status">{{ flash }}</div>{% endif %}
    {% block body %}{% endblock %}
  </main>
  <footer class="footer">© {{ brand.name }} · {{ brand.tagline }} · <a href="/contact">Contact us</a> · <a href="/app">Mobile app</a></footer>
  <script src="/assets/shop.js" defer></script>
</body>
</html>
