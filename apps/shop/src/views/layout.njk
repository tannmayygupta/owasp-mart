<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ brand.name }}{% endblock %} · {{ brand.name }}</title>
  <style>
    body{font-family:system-ui,Arial,sans-serif;margin:0;color:#1b1f24;background:#f6f7f9}
    header{background:#fff;border-bottom:1px solid #e3e6ea;padding:.75rem 1rem;display:flex;gap:1rem;align-items:center}
    header a{color:#1b5fb0;text-decoration:none;margin-right:.75rem}
    main{max-width:900px;margin:1rem auto;padding:0 1rem}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem}
    .card{background:#fff;border:1px solid #e3e6ea;border-radius:8px;padding:1rem}
    .muted{color:#5a6472}.price{font-weight:600}
    form.inline{display:inline}
    input,button,textarea{font:inherit;padding:.4rem;border:1px solid #c3c9d0;border-radius:6px}
    button{background:#1b5fb0;color:#fff;border-color:#1b5fb0;cursor:pointer}
    table{width:100%;border-collapse:collapse}td,th{padding:.4rem;border-bottom:1px solid #e3e6ea;text-align:left}
    .flash{background:#eef7ee;border:1px solid #cbe6cb;padding:.5rem;border-radius:6px;margin:.5rem 0}
  </style>
</head>
<body>
  <header>
    <a href="/shop"><strong>{{ brand.name }}</strong></a>
    <span class="muted">{{ brand.tagline }}</span>
    <span style="flex:1"></span>
    {% if user %}<a href="/orders">Orders</a><a href="/cart">Cart</a>{% if user.role == "customer" %}<a href="/tickets">Support</a>{% endif %}
      <form class="inline" method="post" action="/logout"><input type="hidden" name="csrf" value="{{ csrf }}"><button>Log out ({{ user.email }})</button></form>
    {% else %}<a href="/login">Log in</a>{% endif %}
  </header>
  <main>
    {% if flash %}<div class="flash">{{ flash }}</div>{% endif %}
    {% block body %}{% endblock %}
  </main>
</body>
</html>
