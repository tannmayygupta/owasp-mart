{% extends "layout.njk" %}
{% block title %}Order #{{ order.id }}{% endblock %}
{% block body %}
<p class="crumbs"><a href="/orders">All orders</a> / #{{ order.id }}</p>
<h1>Order #{{ order.id }}</h1>
<p class="kv">Status: <strong><span class="badge b-{{ order.status }}">{{ order.status }}</span></strong> · Total <span class="price">{{ order.total_cents | cents }}</span></p>
<table><tr><th>Item</th><th class="num">Qty</th><th class="num">Unit</th><th>Status</th><th></th></tr>
{% for it in order.items %}
<tr><td>{{ it.title }}</td><td class="num">{{ it.qty }}</td><td class="num">{{ it.unit_price_cents | cents }}</td><td><span class="badge b-{{ it.status }}">{{ it.status }}</span></td>
<td>
  <form class="inline" method="post" action="/refunds"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="order_item_id" value="{{ it.id }}"><button>Refund</button></form>
  <form class="inline" method="post" action="/disputes"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="order_item_id" value="{{ it.id }}"><button>Dispute</button></form>
  <form class="inline" method="post" action="/reviews"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="product_id" value="{{ it.product_id }}"><input name="rating" type="number" min="1" max="5" value="5" style="width:3.8rem" aria-label="Rating"><button>Review</button></form>
</td></tr>
{% endfor %}</table>
{% endblock %}
