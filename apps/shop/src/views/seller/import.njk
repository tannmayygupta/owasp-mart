{% extends "layout.njk" %}{% block title %}Bulk import preview{% endblock %}{% block body %}
<h1>Bulk import preview</h1>
<p class="muted">Preview how a product from a supplier feed will look. The preview is computed by our isolated import service: it merges your fields over the shop's defaults and shows the result.</p>
<form method="post" action="/seller/import-preview">
  <input type="hidden" name="csrf" value="{{ csrf }}">
  <label>Title <input name="title" maxlength="120" required></label>
  <label>Description <textarea name="description" maxlength="2000"></textarea></label>
  <label>Price in cents <input name="price_cents" inputmode="numeric" value="0"></label>
  <label>Advanced options (JSON, optional) <textarea name="options" maxlength="4000" placeholder='{"tags": ["gift"]}'></textarea></label>
  <button>Preview</button>
</form>
<p class="muted">The answer is JSON.</p>
{% endblock %}