{% extends "layout.njk" %}{% block title %}Store staff{% endblock %}{% block body %}
<h1>Store staff</h1>
<table><tr><th>#</th><th>Email</th><th>Role</th><th></th></tr>
{% for u in staff %}<tr>
  <td>{{ u.id }}</td><td>{{ u.email }}</td><td>{{ u.role }}</td>
  <td>{% if u.role == 'seller_staff' %}<form class="inline" method="post" action="/seller/staff/{{ u.id }}/remove"><input type="hidden" name="csrf" value="{{ csrf }}"><button>Remove</button></form>{% endif %}</td>
</tr>{% else %}<tr><td colspan="4" class="muted">No staff.</td></tr>{% endfor %}</table>
<h3>Add staff</h3>
<p class="muted">Enter the email of an existing customer account to make them store staff.</p>
<form method="post" action="/seller/staff">
  <input type="hidden" name="csrf" value="{{ csrf }}">
  <label>Email <input name="email" type="email" maxlength="320" required></label>
  <button>Add</button>
</form>
<p><a href="/seller">Back to dashboard</a></p>
{% endblock %}
