{% extends "layout.njk" %}{% block title %}Payouts{% endblock %}{% block body %}
<h1>Payouts</h1>
<table><tr><th>#</th><th>Store</th><th>Net</th><th>Status</th><th></th></tr>
{% for p in payouts %}<tr><td>{{ p.id }}</td><td>{{ p.store_id }}</td><td>{{ p.net_cents | cents }}</td><td>{{ p.status }}</td>
<td><form class="inline" method="post" action="/staff/payouts/{{ p.id }}/approve"><input type="hidden" name="csrf" value="{{ csrf }}"><button>Approve</button></form></td>
</tr>{% else %}<tr><td colspan="5" class="muted">No payouts.</td></tr>{% endfor %}</table>
<h3>Commissions</h3><p class="muted">{{ commissions|length }} commission rows.</p>
{% endblock %}
