{% extends "layout.njk" %}{% block title %}Audit{% endblock %}{% block body %}
<h1>Audit log</h1>
<table><tr><th>#</th><th>Actor</th><th>Action</th><th>Target</th><th>At</th></tr>
{% for r in rows %}<tr><td>{{ r.id }}</td><td>{{ r.actor_id }}</td><td>{{ r.action }}</td><td>{{ r.target }}</td><td>{{ r.created_at }}</td></tr>{% else %}<tr><td colspan="5" class="muted">Empty.</td></tr>{% endfor %}</table>
<h3>Alerts</h3><p class="muted">{{ alerts|length }} alert(s).</p>
{% endblock %}
