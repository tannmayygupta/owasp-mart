{% extends "layout.njk" %}{% block title %}Users{% endblock %}{% block body %}
<h1>Users</h1>
<table><tr><th>#</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr>
{% for u in users %}<tr><td>{{ u.id }}</td><td>{{ u.email }}</td><td>{{ u.role }}</td><td><span class="badge b-{{ u.status }}">{{ u.status }}</span></td>
<td><form class="inline" method="post" action="/staff/users/{{ u.id }}/status"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="status" value="{% if u.status == 'active' %}suspended{% else %}active{% endif %}"><button>{% if u.status == 'active' %}Suspend{% else %}Activate{% endif %}</button></form></td>
</tr>{% endfor %}</table>
{% endblock %}
