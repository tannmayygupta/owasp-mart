{% extends "layout.njk" %}{% block title %}Refunds{% endblock %}{% block body %}
<h1>Refunds</h1>
<table><tr><th>#</th><th>Item</th><th>Store</th><th>Amount</th><th>Status</th><th></th></tr>
{% for r in refunds %}<tr>
  <td>{{ r.id }}</td><td>{{ r.order_item_id }}</td><td>{{ r.store_id }}</td><td>{{ r.amount_cents | cents }}</td><td><span class="badge b-{{ r.status }}">{{ r.status }}</span></td>
  <td>
    {% if r.status == 'requested' %}
      <form class="inline" method="post" action="/staff/refunds/{{ r.id }}/approve"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="number" name="amount" min="1" placeholder="amount (cents)"><button>Approve</button></form>
      <form class="inline" method="post" action="/staff/refunds/{{ r.id }}/reject"><input type="hidden" name="csrf" value="{{ csrf }}"><button>Reject</button></form>
    {% elif r.status == 'approved' %}
      <form class="inline" method="post" action="/staff/refunds/{{ r.id }}/process"><input type="hidden" name="csrf" value="{{ csrf }}"><button>Process</button></form>
    {% endif %}
  </td>
</tr>{% else %}<tr><td colspan="6" class="muted">No refunds.</td></tr>{% endfor %}</table>
{% include "partials/pager.njk" %}
{% endblock %}
