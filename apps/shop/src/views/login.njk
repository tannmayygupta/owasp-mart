{% extends "layout.njk" %}
{% block title %}Log in{% endblock %}
{% block body %}
<div class="auth">
  <h1>Log in</h1>
  <p class="muted" style="text-align:center">Welcome back to {{ brand.name }}.</p>
  {% if error %}<div class="flash error" role="alert">{{ error }}</div>{% endif %}
  <form method="post" action="/login" class="card">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <input name="email" type="email" placeholder="Email" aria-label="Email" autocomplete="username" required>
    <input name="password" type="password" placeholder="Password" aria-label="Password" autocomplete="current-password" required>
    <button>Log in</button>
  </form>
  <p class="muted" style="text-align:center">Practice lab: there is no sign-up here. Use the account shown under "How to begin" in your lab console.</p>
</div>
{% endblock %}
