{% extends "layout.njk" %}
{% block title %}Orders{% endblock %}
{% block body %}
<h1>Your orders</h1>
<table><tr><th>#</th><th>Status</th><th class="num">Total</th></tr>
{% for o in orders %}<tr><td><a href="/orders/{{ o.id }}">{{ o.id }}</a></td><td><span class="badge b-{{ o.status }}">{{ o.status }}</span></td><td class="num">{{ o.total_cents | cents }}</td></tr>
{% else %}<tr><td colspan="3" class="muted">No orders yet.</td></tr>{% endfor %}</table>
{% include "partials/pager.njk" %}
{% endblock %}
