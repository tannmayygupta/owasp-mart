{
  "schema_version": "0.1",
  "challenges": {
    "C01": {
      "m1": {"kind": "event", "type": "shop.cross_store_order_read", "where": {}},
      "m2": {"kind": "count_distinct", "type": "shop.cross_store_order_read", "where": {}, "field": "order_id", "at_least": 3},
      "m3": {"kind": "flag"}
    },
    "C02": {
      "m1": {"kind": "event", "type": "shop.giftcard_attempt", "where": {"result": {"in": ["unknown_wellformed", "redeemed"]}}},
      "m2": {"kind": "event", "type": "shop.giftcard_attempt", "where": {"result": "redeemed", "card_class": "unsold_test"}},
      "m3": {"kind": "flag"}
    },
    "C03": {
      "m1": {"kind": "any", "of": [
        {"kind": "event", "type": "shop.catalog_query_error", "where": {}},
        {"kind": "event", "type": "proxy.crs_match", "where": {"tags": {"contains": "attack_sqli"}}},
        {"kind": "event", "type": "shop.ticket_markup_stored", "where": {}}
      ]},
      "m2": {"kind": "event", "type": "collector.hit", "where": {"bot_tagged": true}},
      "m3": {"kind": "flag"}
    },
    "C04": {
      "m1": {"kind": "event", "type": "shop.refund_decision", "where": {"path": "quick"}},
      "m2": {"kind": "count", "type": "shop.refund_decision", "where": {"path": "quick", "decision": "auto_approved"}, "at_least": 2, "group_by": "order_id"},
      "m3": {"kind": "flag"}
    },
    "C05": {
      "m1": {"kind": "event", "type": "shop.verbose_error", "where": {"handler": "c05_api"}},
      "m2": {"kind": "event", "type": "ops.page_served", "where": {"client_class": {"ne": "internal"}}},
      "m3": {"kind": "flag"}
    },
    "C06": {
      "m1": {"kind": "event", "type": "import.job", "where": {"flagged_keys": {"nonempty": true}}},
      "m2": {"kind": "event", "type": "import.job", "where": {"polluted": true}},
      "m3": {"kind": "flag"}
    },
    "C07": {
      "m1": {"kind": "event", "type": "auth.reset_requested", "where": {"account_role": "finance"}},
      "m2": {"kind": "any", "of": [
        {"kind": "event", "type": "auth.password_reset_completed", "where": {"account_role": "finance"}},
        {"kind": "count", "type": "auth.reset_confirm_batch", "where": {}, "sum_field": "fail_count", "at_least": 501,
         "then": {"type": "auth.password_reset_completed", "where": {}}}
      ]},
      "m3": {"kind": "flag"}
    },
    "C08": {
      "m1": {"kind": "event", "type": "webhook.received", "where": {"source": "non_gateway"}},
      "m2": {"kind": "event", "type": "order.paid", "where": {"verified": false}},
      "m3": {"kind": "flag"}
    },
    "C09": {
      "m1": {"kind": "event", "type": "auth.attempt", "where": {"route": "legacy"}},
      "m2": {"kind": "negative_window",
             "group_by": "account_id",
             "failures": {"type": "auth.attempt", "where": {"route": "legacy", "result": {"in": ["failure"]}}, "at_least": 20},
             "success": {"type": "auth.attempt", "where": {"route": "legacy", "result": {"in": ["success"]}}},
             "window_s": 600,
             "absent": {"type": "shop.security_event_written", "count": 0},
             "grace_s": 30},
      "m3": {"kind": "flag"}
    },
    "C10": {
      "m1": {"kind": "event", "type": "importer.fetch_attempt", "where": {"url_class": {"in": ["loopback", "private", "link_local", "internal_name"]}}},
      "m2": {"kind": "event", "type": "meta.request_served", "where": {"ua_class": "importer"}},
      "m3": {"kind": "flag"}
    },
    "C11": {
      "m1": {"kind": "event", "type": "kyc.result", "where": {"outcome": "invalid_verbose"}},
      "m2": {"kind": "event", "type": "store.approved", "where": {"approved_by": "system_kyc_fallback"}},
      "m3": {"kind": "flag"}
    }
  }
}
