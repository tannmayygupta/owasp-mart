{
  "name": "@vulnmart/web",
  "version": "0.0.0",
  "private": true,
  "description": "VulnMart dashboards (Next.js). Tracer bullet: one page that shows the API health.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "test:e2e": "pnpm --dir ../../tests/web-e2e install --frozen-lockfile --ignore-workspace && pnpm --dir ../../tests/web-e2e test"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
