# secrets and local config
.env
.env.*
!.env.example
*.pem
*.key
.claude/settings.local.json

# dependencies and build output
node_modules/
__pycache__/
*.pyc
.venv/
dist/
build/
.next/

# crash dumps
*.stackdump

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# BMAD generated render output (rebuilt on every skill run)
_bmad/render/

# Office lock files (a workbook open in Excel)
~$*

# oasdiff binary fetched by scripts/oasdiff.mjs (checksum verified, never committed)
tools/.bin/

# Terraform: local state, plans, variable files and crash logs (the example file is tracked)
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example
*.tfvars.json
tfplan*
*.tfplan
crash.log

# SSH private keys
id_rsa
id_ed25519
id_ecdsa
