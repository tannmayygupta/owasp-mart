#cloud-config
# One baseline for VM-P and VM-I, rendered by Terraform.
package_update: true
package_upgrade: true

ssh_authorized_keys: ${ssh_keys_json}

write_files:
  - path: /etc/ssh/sshd_config.d/00-vulnmart.conf
    encoding: b64
    permissions: "0644"
    content: ${sshd_conf}
  - path: /usr/local/sbin/vulnmart-firewall.sh
    encoding: b64
    permissions: "0755"
    content: ${firewall_sh}
  - path: /usr/local/sbin/vulnmart-install-docker.sh
    encoding: b64
    permissions: "0755"
    content: ${docker_sh}
  - path: /usr/local/sbin/vulnmart-baseline.sh
    encoding: b64
    permissions: "0755"
    content: ${baseline_sh}
  - path: /etc/docker/daemon.json
    encoding: b64
    permissions: "0644"
    content: ${docker_daemon}
  - path: /usr/local/sbin/vulnmart-egress.sh
    permissions: "0755"
    content: |
      ${egress_sh}
  - path: /etc/systemd/system/vulnmart-egress.service
    encoding: b64
    permissions: "0644"
    content: ${egress_unit}
  - path: /etc/vulnmart/egress.env
    permissions: "0644"
    content: ${egress_env}
  - path: /usr/local/sbin/vulnmart-keepalive.py
    encoding: b64
    permissions: "0755"
    content: ${keepalive_py}
  - path: /etc/systemd/system/vulnmart-keepalive.service
    encoding: b64
    permissions: "0644"
    content: ${keepalive_unit}
  - path: /usr/local/sbin/vulnmart-certs.sh
    permissions: "0755"
    content: |
      ${certs_sh}
  - path: /usr/local/sbin/vulnmart-reload-caddy.sh
    permissions: "0755"
    content: |
      ${reload_caddy_sh}
  - path: /etc/systemd/system/vulnmart-certs.service
    permissions: "0644"
    content: |
      ${certs_unit}
  - path: /etc/systemd/system/vulnmart-certs.timer
    permissions: "0644"
    content: |
      ${certs_timer}
  - path: /etc/vulnmart/lego.pin.json
    permissions: "0644"
    content: |
      ${lego_pin}
  - path: /usr/local/sbin/vulnmart-install-lego.sh
    permissions: "0755"
    content: |
      ${lego_install_sh}
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: "0644"
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
  - path: /etc/systemd/timesyncd.conf.d/vulnmart.conf
    permissions: "0644"
    content: |
      [Time]
      NTP=${ntp_server}

# H-111: the baseline is a oneshot unit, retried at each boot and every 30 s until baseline-ok exists.
  - path: /etc/systemd/system/vulnmart-baseline.service
    permissions: "0644"
    content: |
      [Unit]
      After=network-online.target
      Wants=network-online.target
      ConditionPathExists=!/var/lib/vulnmart/baseline-ok
      [Service]
      Type=oneshot
      Environment=DEBIAN_FRONTEND=noninteractive
      ExecStartPre=/usr/bin/apt-get install -y iptables-persistent netfilter-persistent unattended-upgrades ca-certificates curl gnupg python3
      ExecStart=/usr/local/sbin/vulnmart-baseline.sh "${private_cidr}" "${keepalive_enabled}"
      Restart=on-failure
      RestartSec=30
      [Install]
      WantedBy=multi-user.target

runcmd:
  - [systemctl, enable, --now, --no-block, vulnmart-baseline.service]
