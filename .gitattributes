# Normalize text files in the repo.
* text=auto

# Hooks and scripts must keep LF on every machine (a CRLF shell script breaks).
.githooks/* text eol=lf
*.mjs text eol=lf
*.sh text eol=lf

# BMAD skills and runtime: same bytes on every machine, so the hash manifest check works everywhere.
.claude/skills/** text eol=lf
_bmad/** text eol=lf
docs/bmad/skills.sha256 text eol=lf
*.xlsx binary

# Contracts, examples, code and lockfiles: the same bytes on every machine (signatures, derived files and hashes are compared byte for byte).
contracts/** text eol=lf
apps/** text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
uv.lock text eol=lf
pnpm-lock.yaml text eol=lf
