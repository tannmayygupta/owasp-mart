{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulnmart.invalid/contracts/errors/error-codes.schema.json",
  "title": "VulnMart error registry (IF-8)",
  "description": "Shape of contracts/errors/error-codes.yaml. Semantic rules (sorted, unique, family listed, no echo of input) are checked by scripts/validate-errors.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "families", "codes"],
  "properties": {
    "registry_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "families": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Z]{2,6}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "description"],
        "properties": {
          "owner": { "enum": ["P", "L", "T"] },
          "description": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "codes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "status", "title", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z]{2,6}(-[A-Z]+)+$", "maxLength": 60 },
        "status": { "anyOf": [{ "type": "integer", "minimum": 400, "maximum": 599 }, { "type": "null" }] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "retryable": { "type": "boolean" },
        "exit_code": { "type": "integer", "minimum": 1, "maximum": 255 }
      }
    }
  }
}
