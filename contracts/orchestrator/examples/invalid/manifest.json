  },
  "problem-has-detail.json": {
    "schema": "Problem",
    "path": "/detail",
    "rule": "detail is not used: no free text reaches a client"
  },
  "problem-has-instance.json": {
    "schema": "Problem",
    "path": "/instance",
    "rule": "instance is not used"
  },
  "problem-extension-member.json": {
