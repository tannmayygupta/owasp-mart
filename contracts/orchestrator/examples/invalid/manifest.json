    "rule": "ok, degraded or down"
  },
  "state-report-bad-state.json": {
    "schema": "StateReport",
    "path": "/to_state",
    "rule": "state is in the state machine"
  },
  "state-report-missing-reason.json": {
    "schema": "StateReport",
    "path": "/reason",
    "rule": "reason is required"
  },
  "problem-bad-code.json": {
    "schema": "Problem",
    "path": "/code",
    "rule": "code is upper case words joined by hyphens"
  },
  "problem-stack-trace.json": {
    "schema": "Problem",
    "path": "/stack",
    "rule": "never a stack trace (NFR-SEC-03); the schema is closed"
  },
  "create-first-seq-removed.json": {
    "schema": "CreateInstanceRequest",
    "path": "/first_seq",
    "rule": "first_seq was removed in D-42; a body that still has it is refused"
  },
  "reset-first-seq-removed.json": {
    "schema": "ResetInstanceRequest",
    "path": "/first_seq",
    "rule": "first_seq was removed in D-42; a body that still has it is refused"
  },
  "problem-message-member.json": {
    "schema": "Problem",
    "path": "/message",
    "rule": "the old-style message member is gone; the schema is closed"
  },
  "problem-old-style.json": {
    "schema": "Problem",
    "path": "/type",
    "rule": "the members type, title and status are required"
  },
  "problem-type-real-domain.json": {
    "schema": "Problem",
    "path": "/type",
    "rule": "type is urn:vulnmart:error: plus the code"
  },
  "problem-status-string.json": {
    "schema": "Problem",
    "path": "/status",
    "rule": "status is an integer"
  },
  "problem-status-float.json": {
    "schema": "Problem",
    "path": "/status",
    "rule": "status is an integer token, not 429.0"
  },
  "problem-status-not-an-error.json": {
    "schema": "Problem",
    "path": "/status",
    "rule": "status is 400 to 599"
  },
  "problem-missing-title.json": {
    "schema": "Problem",
    "path": "/title",
    "rule": "title is required"
  },
  "problem-trace-member.json": {
    "schema": "Problem",
    "path": "/trace",
    "rule": "never a stack trace (NFR-SEC-03); the schema is closed"
  },
  "state-report-missing-transition.json": {
    "schema": "StateReport",
    "path": "/transition",
    "rule": "transition is required (identity is instance, epoch, transition)"
  },
  "state-report-transition-zero.json": {
    "schema": "StateReport",
    "path": "/transition",
    "rule": "transition starts at 1"
  },
  "state-report-transition-negative.json": {
    "schema": "StateReport",
    "path": "/transition",
    "rule": "transition starts at 1"
  },
  "state-report-transition-float.json": {
    "schema": "StateReport",
    "path": "/transition",
    "rule": "an integer token, not 1.0"
  },
  "state-report-transition-exponent.json": {
    "schema": "StateReport",
    "path": "/transition",
    "rule": "an integer token, not 1e0"
  },
  "state-report-transition-string.json": {
    "schema": "StateReport",
    "path": "/transition",
    "rule": "transition is a number, not a string"
  },
  "state-report-transition-boolean.json": {
    "schema": "StateReport",
    "path": "/transition",
    "rule": "a boolean is not an integer"
  },
  "state-report-transition-huge.json": {
    "schema": "StateReport",
    "path": "/transition",
    "rule": "at most 2^53 - 1"
  },
  "state-report-epoch-float.json": {
    "schema": "StateReport",
    "path": "/epoch",
    "rule": "an integer token, not 1.0"
  },
  "create-epoch-float.json": {
    "schema": "CreateInstanceRequest",
    "path": "/epoch",
    "rule": "an integer token, not 1.0"
  },
  "create-epoch-exponent.json": {
    "schema": "CreateInstanceRequest",
    "path": "/epoch",
    "rule": "an integer token, not 1e0"
  },
  "create-epoch-boolean.json": {
    "schema": "CreateInstanceRequest",
    "path": "/epoch",
    "rule": "a boolean is not an integer"
  },
  "create-epoch-huge.json": {
    "schema": "CreateInstanceRequest",
    "path": "/epoch",
    "rule": "at most 2^53 - 1"
  },
  "create-memory-float.json": {
    "schema": "CreateInstanceRequest",
    "path": "/limits/memory_mb",
    "rule": "an integer token, not 1024.0"
  },
