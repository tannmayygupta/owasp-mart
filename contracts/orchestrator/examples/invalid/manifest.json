    "rule": "an integer token, not 2.0"
  },
  "access-epoch-float.json": {
    "schema": "AccessRequest",
    "path": "/access_epoch",
    "rule": "an integer token, not 1.0"
  },
  "access-epoch-boolean.json": {
    "schema": "AccessRequest",
    "path": "/access_epoch",
    "rule": "a boolean is not an integer"
  },
  "host-capacity-float.json": {
    "schema": "HostStatus",
