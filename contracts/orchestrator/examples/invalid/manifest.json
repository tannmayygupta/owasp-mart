    "schema": "ResetInstanceRequest",
    "path": "/epoch",
    "rule": "a reset epoch is at least 2"
  },
  "create-missing-owner-hash.json": {
    "schema": "CreateInstanceRequest",
    "path": "/owner_hash",
    "rule": "owner_hash is required"
  },
  "create-owner-hash-short.json": {
    "schema": "CreateInstanceRequest",
    "path": "/owner_hash",
    "rule": "owner_hash is 64 hex characters"
  },
  "create-owner-hash-uppercase.json": {
    "schema": "CreateInstanceRequest",
    "path": "/owner_hash",
    "rule": "owner_hash is lowercase hex"
  },
  "create-owner-hash-email.json": {
    "schema": "CreateInstanceRequest",
    "path": "/owner_hash",
    "rule": "owner_hash is never an email"
  },
  "reset-owner-hash.json": {
    "schema": "ResetInstanceRequest",
    "path": "/owner_hash",
    "rule": "a reset keeps the owner of the instance"
  },
  "reset-template-field.json": {
    "schema": "ResetInstanceRequest",
    "path": "/template_id",
    "rule": "reset cannot change the template"
  },
