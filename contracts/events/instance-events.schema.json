{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulnmart.invalid/contracts/events/instance-events.schema.json",
  "title": "Signed instance event on the wire (IF-4, contract 0.1)",
  "description": "One event as the ingest receives it: sidecar to edge relay to ingest, one event per request. The event identity is (instance_id, seq). The signature travels in the X-VM-Signature header, not in the body (see app-events.md). Each event type has its own data rule in $defs and its allowed source; data holds ids, classes, counts and hashes only (evidence.capture is the one exception) and never a flag-shaped value. The flag-shaped check is best effort and not a guarantee: the text definitions reject any string holding \"VM{\" in any letter case, \"VM%7B\" or a full-width brace, and the real flag format belongs to FR-FLG-02. The sidecar replaces flag-like strings in evidence.capture with the marker [FLAG-REDACTED] before sending. Rules that depend on two fields: source bot needs session_kind bot; session_kind internal is only for the sources import, orchestrator and platform; proxy.flag_seen needs data.challenge_key for kind real and decoy and forbids it for foreign. The envelope challenge_key and data.challenge_key of proxy.flag_seen must not differ; JSON Schema cannot compare two values, so scripts/validate-events.mjs and the fake ingest check that.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance_id",
    "seq",
    "type",
    "source",
    "session_kind",
    "user_id",
    "ts",
    "data"
  ],
