    "schema_version": {
      "const": "0.1"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^i-[A-Z2-7]{16}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "type": {
      "type": "string",
      "enum": [
        "proxy.request",
        "proxy.crs_match",
        "proxy.flag_seen",
        "evidence.capture",
        "shop.cross_store_order_read",
        "shop.giftcard_attempt",
        "shop.catalog_query_error",
        "shop.ticket_markup_stored",
        "bot.visit",
        "collector.hit",
        "shop.refund_decision",
        "shop.refund_invariant_broken",
        "shop.verbose_error",
        "ops.page_served",
        "import.job",
        "auth.reset_requested",
        "auth.reset_confirm_batch",
        "auth.password_reset_completed",
        "auth.attempt",
        "shop.security_event_written",
        "webhook.received",
        "order.paid",
        "gateway.ledger_entry",
        "importer.fetch_attempt",
        "meta.request_served",
        "kyc.result",
        "store.approved",
        "instance.flags_injected",
        "infrastructure_fault"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "sidecar",
        "shop",
        "import",
        "mock",
        "bot",
        "orchestrator",
        "platform"
      ]
    },
    "session_kind": {
      "type": "string",
      "enum": [
        "player",
        "bot",
        "anon",
        "internal"
      ]
    },
    "user_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/id"
        }
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "challenge_key": {
      "$ref": "#/$defs/challenge_key"
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "proxy.request"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "sidecar"
