  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,64}$"
    },
    "class": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,32}$"
    },
    "challenge_key": {
      "type": "string",
      "pattern": "^C(0[1-9]|1[01])$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "text200": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^(?![\\s\\S]*[Vv][Mm](?:\\{|%7[Bb]|\\uFF5B))[\\s\\S]*$"
    },
    "text512": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?![\\s\\S]*[Vv][Mm](?:\\{|%7[Bb]|\\uFF5B))[\\s\\S]*$"
    },
    "data_proxy_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "route_template",
        "status",
        "resp_len",
        "client_class"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS",
            "other"
          ]
        },
        "route_template": {
          "$ref": "#/$defs/text200"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "resp_len": {
          "$ref": "#/$defs/count"
        },
        "client_class": {
          "$ref": "#/$defs/class"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "data_proxy_crs_match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_ids",
        "tags",
        "anomaly_score",
        "route_template"
      ],
      "properties": {
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{3,9}$"
          },
          "maxItems": 50
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/class"
          },
          "maxItems": 20
        },
        "anomaly_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "route_template": {
          "$ref": "#/$defs/text200"
        }
      }
    },
    "data_proxy_flag_seen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "candidate_sha256"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "real",
            "decoy",
            "foreign"
          ]
        },
        "challenge_key": {
          "$ref": "#/$defs/challenge_key"
        },
        "candidate_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "route_template": {
          "$ref": "#/$defs/text200"
        },
        "request_ref": {
          "$ref": "#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "real",
                  "decoy"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "challenge_key"
            ]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "foreign"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "challenge_key": false
            }
          }
        }
      ]
    },
    "data_evidence_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_ref",
        "body",
        "headers_redacted"
      ],
      "properties": {
        "request_ref": {
          "$ref": "#/$defs/id"
        },
        "body": {
          "type": "string",
          "maxLength": 8192,
          "pattern": "^(?![\\s\\S]*[Vv][Mm](?:\\{|%7[Bb]|\\uFF5B))[\\s\\S]*$"
        },
        "headers_redacted": {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9-]{1,64}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/text512"
          }
        }
      }
    },
    "data_shop_cross_store_order_read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_id",
        "caller_user_id",
        "caller_store_id",
        "order_store_id"
      ],
      "properties": {
        "order_id": {
          "$ref": "#/$defs/id"
        },
        "caller_user_id": {
          "$ref": "#/$defs/id"
        },
        "caller_store_id": {
          "$ref": "#/$defs/id"
        },
        "order_store_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "data_shop_giftcard_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "result",
        "card_class"
      ],
      "properties": {
        "user_id": {
          "$ref": "#/$defs/id"
        },
